---
import MyMouseDemo from './demos/MyMouseDemo.astro';
import MyBsqDemo from './demos/MyBsqDemo.astro';

interface Props {
  id: string;
}

const demos = {
  'my-mouse': MyMouseDemo,
  'my-bsq': MyBsqDemo,
};

const Demo = demos[Astro.props.id as keyof typeof demos];
---

{Demo ? <Demo /> : <p role="status">Esta demonstração não está disponível no momento.</p>}
