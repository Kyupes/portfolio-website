---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/pt';
const isProjects = path === '/pt/projetos' || path.startsWith('/pt/projetos/');
---

<a class="skip-link" href="#main-content">Ir para o conteúdo</a>
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/pt/" aria-label="Portfólio — início">portfólio<span>.</span></a>
    <nav aria-label="Navegação principal">
      <ul>
        <li><a href="/pt/" aria-current={isHome ? 'page' : undefined}>Início</a></li>
        <li><a href="/pt/projetos" aria-current={isProjects ? 'page' : undefined}>Projetos</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    z-index: 10;
    top: -5rem;
    left: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--space-1);
    background: var(--color-link);
    color: var(--color-on-accent);
  }

  .skip-link:focus-visible {
    top: var(--space-1);
  }

  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: min(100%, var(--page-width));
    margin-inline: auto;
    padding: var(--space-2) clamp(var(--space-2), 4vw, var(--space-4));
  }

  .site-header__brand {
    color: var(--color-text);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .site-header__brand span {
    color: var(--color-link);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border-radius: var(--space-1);
    color: var(--color-muted);
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--color-code-background);
    color: var(--color-link-hover);
  }

  @media (max-width: 28rem) {
    .site-header__inner {
      flex-wrap: wrap;
    }
  }
</style>
