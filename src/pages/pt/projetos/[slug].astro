---
import { getCollection } from 'astro:content';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPortugueseProjects } from '../../../lib/portuguese-projects';

export async function getStaticPaths() {
  const projects = getPortugueseProjects(
    await getCollection('projects'),
    await getCollection('projectContent'),
  );

  return projects.map(({ project, content, slug }) => ({
    params: { slug },
    props: { project, content },
  }));
}

const { project, content } = Astro.props;
---

<BaseLayout title={`${content.data.title} | Projetos`} lang="pt-BR" description={content.data.summary}>
  <p><a href="/pt/projetos">Todos os projetos</a></p>
  <ProjectDetail project={project} content={content} />
</BaseLayout>
