---
import { getCollection } from 'astro:content';
import ProjectCard from '../../../components/ProjectCard.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPortugueseProjects } from '../../../lib/portuguese-projects';

const projects = getPortugueseProjects(
  await getCollection('projects'),
  await getCollection('projectContent'),
);
---

<BaseLayout
  title="Projetos | Portfólio de Engenharia de Software"
  lang="pt-BR"
  description="Projetos de engenharia de software, backend e desenvolvimento web."
>
  <SiteHeader slot="site-header" />
  <h1>Projetos</h1>
  {
    projects.length === 0 ? (
      <p>Os projetos serão publicados em breve.</p>
    ) : (
      <ul class="project-list">
        {projects.map(({ project, content }) => (
          <li>
            <ProjectCard
              title={content.data.title}
              summary={content.data.summary}
              slug={project.data.slug}
              status={project.data.status}
              origin={project.data.origin}
              technologies={project.data.technologies}
            />
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .project-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-3);
    max-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-list > li {
    min-width: 0;
  }
</style>
